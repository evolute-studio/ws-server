// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum LobbyStatus {
  waiting
  ready
}

enum PlayerRole {
  player
  spectator
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

// Lobby model
model Lobby {
  id            String        @id @default(uuid())
  code          String        @unique @db.VarChar(6)
  hostAddress   String        @db.VarChar(255)
  status        LobbyStatus   @default(waiting)
  created       DateTime      @default(now())
  lastActivity  DateTime      @updatedAt
  currentMatch  String?       @db.VarChar(255)

  // Relations
  players       LobbyPlayer[]
  chatMessages  ChatMessage[]

  @@index([code])
  @@index([hostAddress])
  @@index([lastActivity])
  @@map("lobbies")
}

// Lobby players and spectators
model LobbyPlayer {
  id            String      @id @default(uuid())
  lobbyId       String
  playerAddress String      @db.VarChar(255)
  role          PlayerRole
  joinedAt      DateTime    @default(now())

  // Relations
  lobby         Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
  @@index([playerAddress])
  @@map("lobby_players")
}

// Chat messages
model ChatMessage {
  id            String      @id @default(uuid())
  lobbyId       String
  playerAddress String      @db.VarChar(255)
  message       String      @db.Text
  timestamp     DateTime    @default(now())

  // Relations
  lobby         Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
  @@index([timestamp])
  @@map("chat_messages")
}

// Invitations
model Invitation {
  id                String           @id @default(uuid())
  fromPlayerAddress String           @db.VarChar(255)
  toPlayerAddress   String           @db.VarChar(255)
  lobbyCode         String           @db.VarChar(6)
  timestamp         DateTime         @default(now())
  status            InvitationStatus @default(pending)

  @@index([toPlayerAddress, status])
  @@index([lobbyCode])
  @@index([timestamp])
  @@map("invitations")
}
